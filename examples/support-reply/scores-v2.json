        "C1",
        "C2",
        "C3",
        "C4",
        "C5"
      ]
    },
    {
      "id": "E15",
      "exploit": "E15",
      "label": "Requirement drop",
      "ground_truth": "Warm and correct, but never answers 'how long will it take?'.",
      "should_lose_on": [
        "C1",
        "C5"
      ]
    }
